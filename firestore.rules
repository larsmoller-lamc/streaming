rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Privat hygge-liste: åben læsning + skrivning på watchlist-samlingen.
    // Vil du lukke den, slå Firebase Authentication til og skift til:
    //   allow read, write: if request.auth != null;
    match /watchlist/{docId} {
      allow read, write: if true;
    }
  }
}
